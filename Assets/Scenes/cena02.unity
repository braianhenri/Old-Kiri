  - {fileID: -1511541753744941589, guid: b768823be7bbe2e48b176193b8c3557d, type: 3}
  - {fileID: 2203548970814954772, guid: b768823be7bbe2e48b176193b8c3557d, type: 3}
  - {fileID: 8815449687249642895, guid: b768823be7bbe2e48b176193b8c3557d, type: 3}
  - {fileID: 2463662825140732956, guid: b768823be7bbe2e48b176193b8c3557d, type: 3}
  - {fileID: 9004108660374518437, guid: b768823be7bbe2e48b176193b8c3557d, type: 3}
  nomeTaison: Taison
  rostosJogador:
  - {fileID: 2100582690, guid: 60bff770bf696324db38b17a23de0f47, type: 3}
  - {fileID: -642972993, guid: 60bff770bf696324db38b17a23de0f47, type: 3}
  - {fileID: -1662922078, guid: 60bff770bf696324db38b17a23de0f47, type: 3}
  - {fileID: 527800740, guid: 60bff770bf696324db38b17a23de0f47, type: 3}
  nomeJogador: Xomi
  falasIniciais:
  - quem: 1
    texto: "Com licen\xE7a... Por acaso voc\xEA \xE9 o Taison?"
  - quem: 2
    texto: Quem pergunta...Burp!
  painelOpcoes: {fileID: 1193064385}
  botoesOpcao:
  - {fileID: 130478842}
  - {fileID: 1826850450}
  - {fileID: 517664544}
  textosOpcao:
  - {fileID: 259548100}
  - {fileID: 625323621}
  - {fileID: 1912017674}
  opcoes:
  - textoOpcao: "Meu nome \xE9... bom eu vim aqui porque o Senhorio me mandou, senhor"
    resposta:
    - quem: 2
      texto: "P#@a que p@#iu mas agora ele tem capangas... voc\xEA \xE9 a P@#$a de
        um Minion \xE9?"
    aoEscolher:
      m_PersistentCalls:
        m_Calls: []
  - textoOpcao: E te interessa?
    resposta: []
    aoEscolher:
      m_PersistentCalls:
        m_Calls: []
  - textoOpcao: "Meu nome \xE9.... \xE9... nem eu sei direito"
    resposta:
    - quem: 2
      texto: "C\xEA \xE9 estranho ein mlk, rala daqui"
    aoEscolher:
      m_PersistentCalls:
        m_Calls: []
  jogadorFalaAOpcao: 1
  velocidadeTexto: 0.05
  tempoCadaSprite: 0.25
  tempoEntreFalas: 1.5
  audioSource: {fileID: 0}
  somTeclado: {fileID: 0}
  intervaloSom: 0.08
  scriptMovimento: {fileID: 0}
  larguraOpcao: 800
  alturaOpcao: 80
  espacoEntreOpcoes: 15
  margemDoXomi: 40
  tamanhoFonteOpcao: 40
  escolhasSeguintes:
  - aposOpcao: 0
    opcoes:
    - textoOpcao: "Eu s\xF3 vim pegar o que ele pediu, n\xE3o quero brigar"
      resposta:
      - quem: 2
        texto: "Hmmm.. Tu quer dinheiro n\xE9? saiba que dinheiro nao cai em \xE1rvore"
      - quem: 2
        texto: Vai ter que conquistar...
      aoEscolher:
        m_PersistentCalls:
          m_Calls:
          - m_Target: {fileID: 0}
            m_TargetAssemblyTypeName: 
            m_MethodName: 
            m_Mode: 0
            m_Arguments:
              m_ObjectArgument: {fileID: 0}
              m_ObjectArgumentAssemblyTypeName: 
              m_IntArgument: 0
              m_FloatArgument: 0
              m_StringArgument: 
              m_BoolArgument: 0
            m_CallState: 2
    - textoOpcao: "E tu \xE9 quem o idoso do ca#@$ho"
      resposta: []
      aoEscolher:
        m_PersistentCalls:
          m_Calls: []
    - textoOpcao: ...
      resposta:
      - quem: 2
        texto: "Hmmmm, C\xEA quer diheiro n\xE9 mlk? saiba que dinheiro n\xE3o da
          em \xE1rvore, aqui n\xE3o \xE9 uma cidade rica, de onde voce parece ter
          sa\xEDdo."
      - quem: 2
        texto: Vai ter que onquistar...
      aoEscolher:
        m_PersistentCalls:
          m_Calls: []
